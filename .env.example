# Core
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
MOCK_MODE=true

# LLM (Gemini default; swap adapter if desired)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RESEARCH_MODEL=gemini-2.5-pro

# External discovery
TAVILY_API_KEY=
YOUTUBE_API_KEY=
ARXIV_BASE_URL=https://export.arxiv.org/api/query

# Canvas LMS
CANVAS_BASE_URL=
CANVAS_ACCESS_TOKEN=
CANVAS_ALLOWED_COURSE_IDS=

# Existing RAG service. Point this to your current Neo4j/Chroma/Qdrant retrieval API.
RAG_SERVICE_URL=http://rag-service:8010
RAG_SERVICE_API_KEY=

# Datastores
DATABASE_URL=postgresql+psycopg://edu:edu@postgres:5432/edu
REDIS_URL=redis://redis:6379/0
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
CHROMA_HOST=chroma
CHROMA_PORT=8000
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=edu-rag
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=change-me
AWS_REGION=us-east-1

# Auth. DEV_AUTH_BYPASS must be false in production.
DEV_AUTH_BYPASS=true
OIDC_ISSUER=
OIDC_AUDIENCE=edu-multiagent
OIDC_JWKS_URL=

# Runtime controls
MAX_TOOL_CALLS=12
MAX_AGENT_STEPS=10
REQUEST_TIMEOUT_SECONDS=45
ENABLE_CODE_SANDBOX=false
SANDBOX_SERVICE_URL=http://sandbox:8020

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=edu-multiagent
